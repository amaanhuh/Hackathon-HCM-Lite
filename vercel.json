{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/employee", "destination": "/employee.html" },
    { "source": "/employees", "destination": "/employees.html" },
    { "source": "/leaves", "destination": "/leaves.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/payslip", "destination": "/payslip.html" }
  ]
}
